# Isolated Supabase project for Teller integration tests ONLY.
# Copy to .env.integration and fill with a disposable/non-production project.
# NEVER use production ref ypixbxicdecwfafculha here.

NEXT_PUBLIC_SUPABASE_URL=https://your-isolated-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-isolated-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-isolated-service-role-key
SUPABASE_DB_URL=postgresql://...

RUN_INTEGRATION_TESTS=1
TELLER_ALLOW_INTEGRATION_DB=1
TELLER_EXPECTED_BRANCH=phase4-testing
