# Controlled production Phase 4 testing (ypixbxicdecwfafculha only).
# Copy to .env.controlled-prod.local — never commit secrets.

TELLER_CONTROLLED_PROD_TEST=1

# Set after creating "Teller Phase 4 Test" org via setup script
# TELLER_CONTROLLED_TEST_ORG_ID=

# Optional second org for cross-org security tests
# TELLER_CONTROLLED_FOREIGN_ORG_ID=

