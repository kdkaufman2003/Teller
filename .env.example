# Supabase — Teller's own project (separate from Hassle Free AC)
NEXT_PUBLIC_SUPABASE_URL=https://your-teller-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only: required for setup and inbound HFAC webhooks
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Teller URL (auth emails, webhook docs; no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hassle Free AC platform URL (sidebar + Settings when connected)
NEXT_PUBLIC_HFAC_URL=https://your-hassle-free-ac.vercel.app

# Inbound won-deal webhook from Hassle Free AC
# Preferred: HMAC headers X-Teller-Event-Id, X-Teller-Timestamp, X-Teller-Signature
# Migration fallback: Authorization: Bearer <TELLER_HFAC_WEBHOOK_SECRET>
TELLER_HFAC_WEBHOOK_SECRET=your-shared-webhook-secret

# HFAC webhook migration controls (Phase 0.5)
# TELLER_HFAC_WEBHOOK_LEGACY_BEARER=true   # allow bearer during HFAC rollout; set false when HFAC signs requests
# TELLER_HFAC_REQUIRE_EXTERNAL_MAPPING=true # reject webhooks without mapped HFAC company/account id

# Integration tests (isolated Supabase project only — never production)
# Copy .env.integration.example → .env.integration with a disposable Supabase project.
# RUN_INTEGRATION_TESTS=1
# TELLER_ALLOW_INTEGRATION_DB=1
# TELLER_EXPECTED_BRANCH=phase4-testing

# Legacy env name — still supported
# TELLER_QUOTER_WEBHOOK_SECRET=

# Optional — receipt reading (photos + PDF text). Required for automatic vendor/amount extraction.
# OPENAI_API_KEY=

# Optional — read-only bank import via Plaid (Phase 7)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# PLAID_WEBHOOK_URL=
# PLAID_REDIRECT_URI=
