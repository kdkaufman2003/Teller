# Supabase — Project Settings → API
# Teller tables are prefixed teller_ so this can be the SAME project as Quoter.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only: Project Settings → API → service_role (setup + Quoter sync)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used in auth emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Link to Hassle Free AC Quoter (shown when attached; sidebar + settings)
NEXT_PUBLIC_HFAC_QUOTER_URL=https://mini-split-quoter.vercel.app

# Shared-project Quoter sync (default: on when Teller and Quoter share Supabase)
# Set to 0 to disable reading dealer_accounts / won quotes from this project.
TELLER_QUOTER_SHARED_SUPABASE=1

# Inbound quote → invoice webhook (Quoter or Zapier/Make)
# Authorization: Bearer <TELLER_QUOTER_WEBHOOK_SECRET>
TELLER_QUOTER_WEBHOOK_SECRET=
